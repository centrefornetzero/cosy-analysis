# Define the range of sample sizes to test
sample_sizes <- seq(500, 2000, 500) # example sizes

library(bench)

# Function to run benchmark
run_benchmark <- function(sample_size) {
  bench_result <- bench::mark(
    estimate_coeffs(useT=0.1, useC=0, length_trial=5, analysis_type="iv", sim=123456, sample_size=sample_size),
    memory = TRUE,
    check = FALSE
  )
  
  # find out sample size
  # which dataset
  set.seed(123456)
  mpan_selection <- sample(df$mpan_identifier %>% unique, sample_size)
  N <- df[df$mpan_identifier %in% mpan_selection,]$mpan_identifier %>% length()
  
  # Extract time and memory
  time_taken <- summary(bench_result)[["median"]]
  memory_used <- summary(bench_result)[["mem_alloc"]]
  
  # Return a list with time and memory
  return(list(sample_size = N, time = as.numeric(time_taken), memory = as.numeric(memory_used)))
}

# Use lapply to apply the benchmark function to each sample size
results_list <- lapply(sample_sizes, run_benchmark)

# Convert the list of lists to a list of one-row data frames
results_rows <- lapply(results_list, function(x) { as.data.frame(matrix(unlist(x), nrow = 1)) })

# Combine all the one-row data frames into one data frame
results <- do.call(rbind, results_rows)
names(results) <- c("sample_size", "time", "memory")

# Print the results
print(results)

# Given data points
# Log-log linear model for time
model_time <- lm(log(time) ~ log(sample_size), data = results)

# Log-log linear model for memory
model_memory <- lm(log(memory) ~ log(sample_size), data = results)

# New sample sizes for prediction
new_sample_sizes <- c(results$sample_size, 25e6, 50e6, 75e6, 100e6, 125e6, 150e6, 175e6, 200e6)

# what would be the prediction if the data was all setosa?
newdata = data.frame(sample_size = new_sample_sizes)
newdata$predicted_time = exp(predict(model_time, newdata = newdata))
newdata$predicted_memory = exp(predict(model_memory, newdata = newdata))
newdata$predicted_memory_GB = newdata$predicted_memory / 8e+9

# Create a data frame for the predicted results
predictions <- data.frame(
  sample_size = new_sample_sizes,
  predicted_time = predicted_time,
  predicted_memory = predicted_memory
)
# Print the predictions
print(predictions)



