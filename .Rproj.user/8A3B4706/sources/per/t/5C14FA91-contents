# estimate coefficients
estimate_coeffs <- function(useT, useC, length_trial=5, analysis_type = "iv", sim=123456, sample_size = 325 ) {
  # 
  # useT = 0.1
  # useC = 0
  # length_trial=6
  # sim=123456
  # sample_size = 325
  # 
  # 
  # print(paste(useT, useC, length_trial, analysis_type, sim, sample_size))
  
  # length_trial =6
  # useC=0
  # useT=0.5
  l = 9 - length_trial
  
  # set seed
  set.seed(sim)
  
  # which dataset
  mpan_selection <- sample(df$mpan_identifier %>% unique, sample_size)
  
  # simulation
  dat <- df  %>% 
    filter(mpan_identifier %in% mpan_selection) %>%
    group_by(mpan_identifier, rate) %>%
    summarise(avg_consumption = mean(consumption, na.rm = TRUE)) %>%
    filter(avg_consumption>0, avg_consumption<2)  # trim extreme values 
  
  # average daytime consumption
  mean_consumption <- dat %>%
    inner_join(df, by = c("mpan_identifier", "rate")) %>%
    filter(month > l) %>%
    group_by(rate) %>%
    summarise(mean_consumption = mean(consumption, na.rm = TRUE)) 
  
  # set the proportion treat
  n <- dim(dat)[1]
  dat$trt <- simple_ra(n, 0.8)
  
  # assign treatment
  dat <- dat %>%
    arrange(trt)
  
  # Create use variable using the provided useT and useC values
  dat$use <- c(rbinom((dat %>% filter(trt == 0) %>% dim())[1], 1, useC),
               rbinom((dat %>% filter(trt == 1) %>% dim())[1], 1, useT))
  
  # Merge and preprocess the data as per your original script
  reg_df <- dat %>%
    inner_join(df, by = c("mpan_identifier", "rate")) %>% 
    filter(month > l) %>%
    filter(!day_of_week == "Sun", !rate == "off-peak")
  
  if (analysis_type=="itt") {
    # itt
    model_summary <- feols(consumption ~ trt +  avg_consumption | date_day, 
                           data = reg_df, split = ~ rate,   
                           cluster = ~ mpan_identifier, se = "cluster")
  }
  if (analysis_type=="iv") {
    # iv
    model_summary <- feols(consumption ~ avg_consumption | date_day | use  ~ trt, 
                           data = reg_df, split = ~ rate,  
                           cluster = ~ mpan_identifier, se = "cluster")
  } 
  
  # Extract the entire summary tables for each model and convert to data.table format
  coefficients_list <- lapply(1:length(unique(reg_df$rate)), function(i) {
    coef_df <- as.data.table(model_summary[[i]]$coeftable)
    coef_df[, varname := names(model_summary[[i]]$coefficients)]
    coef_df[, rate := unique(reg_df$rate)[i]]
    coef_df[, MDES := `Std. Error`*2.8]
    coef_df[, MDES_consumption := MDES/ mean_consumption[mean_consumption$rate==unique(reg_df$rate)[i], ]$mean_consumption]
    # Bind parameters to the coefficient dataframe
    coef_df[, c("useT", "useC", "lengthTrial", "analysis_type" , "seed", "sample_size") := .(useT, useC, length_trial, analysis_type, sim, sample_size )]
    return(coef_df)
  })
  
  # Combine the coefficient tables from itt and iv into one data.table
  combined_coef <- rbindlist(coefficients_list, idcol = "model")
  
  return(combined_coef)
}

# Example usage
