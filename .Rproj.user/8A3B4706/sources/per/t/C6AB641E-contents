model1_late_signup <- feols(consumption ~  i(time_since_event, -1) |  hour | i(time_since_event, opted_in, -1) ~  i(time_since_event, treat, -1), data = event_study, cluster = ~ account_id, se = "cluster")

etable(model1_late_signup)
