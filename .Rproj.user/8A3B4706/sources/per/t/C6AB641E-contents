## Event study

```{r}

# select a subsample to keep the data ok
accounts <- readRDS("../data/scratch/accounts.RDS")

set.seed(12345)
random_treat <- sample(accounts[accounts$is_treat ==1,]$account_id, 10000)
random_control <- sample(accounts[accounts$is_treat ==0,]$account_id, 10000)

accounts_selection <- accounts %>%
  filter(account_id %in% random_control | account_id %in% random_treat) 
accounts_selection <- accounts_selection$account_id

# Assuming accounts_selection is a vector of account_ids
accounts_selection <- paste0(accounts_selection,  collapse = ", ")

# Constructing the SQL query
sql <- paste("SELECT a.account_id, a.treat, a.interval_start, ",
             "(CASE WHEN a.export_read_value IS NOT NULL THEN a.read_value - a.export_read_value ELSE a.read_value END) AS consumption ",
             "FROM `cnz-data-warehouse-d66eb552a5.src_saving_sessions_2.treatment_elec_interval` as a ",
             "WHERE a.account_id IN (", accounts_selection, ");", sep = "")


# Run the query; this returns a bq_table object that you can query further
tb <- bq_project_query(projectid, sql)

# Store the rows of the data in a tibble
# Specifying n_max in bq_table_download might not be necessary if you only want the first 100 rows
df <- bq_table_download(tb, n_max = Inf, page_size = 100000)


# Merge together
event_study <- df %>%
  left_join(baseline %>% 
              select(account_id, is_opted_into_event, campaign_created_at)) %>%
  mutate(opted_in = ifelse(is_opted_into_event == TRUE, 1, 0),
         opted_in = ifelse(is.na(opted_in), 0, opted_in),
         signed_up = ifelse(as.Date(campaign_created_at)<= as.Date("2023-11-16  17:30:00 UTC"), 1, 0),
         signed_up = ifelse(is.na(signed_up), 0, signed_up)) 

# Define the event start time
event_start <- as.POSIXct("2023-11-16 17:30:00", tz = "UTC")

event_study <- event_study %>%
  mutate(time_since_event = round(difftime(interval_start, event_start, units = "hours")/2),
         hour = hour(interval_start))
summary(event_study)

```
```{r}

model1_ols <- feols(consumption ~  i(time_since_event, is_opted_into_event, -1) | interval_start + as.factor(hour) + account_id, 
                    data = event_study, 
                    cluster = ~ account_id, 
                    se = "cluster")
etable(model1_ols)
coefplot(model1_ols,keep=".is_opted_into_event")
```
