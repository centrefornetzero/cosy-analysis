```{r download-data, eval=FALSE, include=FALSE}
# Set your query
sql <- 'SELECT DISTINCT interval_start FROM `cnz-data-warehouse-d66eb552a5.src_saving_sessions_2.treatment_elec_interval`;'

# Run the query; this returns a bq_table object that you can query further
tb <- bq_project_query(projectid, sql)

# Store the rows of the data in a tibble
intervals <- bq_table_download(tb)

# Function to split the vector into chunks
split_into_chunks <- function(vec, chunk_size) {
  split(vec, ceiling(seq_along(vec)/chunk_size))
}

# Retrieve all interval_start timestamps and sort them
interval_starts <- sort(as.character(intervals$interval_start))
chunk_size <- 2 # Define your chunk size
chunks <- split_into_chunks(interval_starts, chunk_size)

# Process each chunk
for (i in seq_along(chunks)) {
  chunk <- chunks[[i]]
  
  # Convert interval_start list to a comma-separated string of literals
  # Assuming interval_start is a timestamp, they should be formatted as string literals
  intervals_list <- paste(sprintf("'%s'", chunk), collapse = ", ")
  
  # Modify your query to include a WHERE clause for the interval_start
  sql <- sprintf(
    "SELECT * FROM `cnz-data-warehouse-d66eb552a5.src_saving_sessions_2.treatment_elec_interval`
      WHERE interval_start IN (%s)",
    intervals_list
  )
  
  # Run the query for the current chunk
  tb <- bq_project_query(projectid, sql)
  df <- bq_table_download(tb)
  
  # Save the data in a uniquely named file
  saveRDS(df, paste0("../data/scratch/df_chunk_", i, ".RDS"))
}


# Assuming your working directory is set correctly to where the "../data/scratch/" folder is located
all_files <- list.files(path = "../data/scratch", pattern = "df_chunk_.*\\.RDS", full.names = TRUE)
all_dfs <- lapply(all_files, readRDS)
df <- do.call(rbind, all_dfs)

# Convert your dataframe to a data.table
df <- as.data.table(df)

