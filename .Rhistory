) %>%
left_join(weather, by = c("gsp_group_id", "settlement_week" = "week_date"))
# Define overall_weekly by merging with electricity data
overall_weekly <- hp_installed %>%
filter(rate_period == "Overall") %>%
mutate(settlement_week = floor_date(date, "week") + 1,
is_hp_installed = as.numeric(installed_at <= settlement_week)) %>%
group_by(account_id, hashed_mpan, tariff_gsp_group_id, settlement_week, treated, installed_at, is_hp_installed) %>%
summarise(elec_consumption = sum(total_consumption)) %>%
rename(gsp_group_id = tariff_gsp_group_id) %>%
left_join(merged_data %>%
select(account_id, settlement_week, weekly_consumption) %>%
rename(gas_consumption = weekly_consumption)) %>%
left_join(weather %>% rename(settlement_week = week_date)) %>%
mutate(
gas_consumption = 52.25 * gas_consumption,
elec_consumption = 52.25 * elec_consumption,
total_consumption = gas_consumption + elec_consumption
)
rm(all_combinations, cosy_hp_install_gas_consumption, merged_data, weather, all_weeks, max_date, min_date)
# Function to estimate treatment effect and save RDS file
estimate_and_save <- function(yname, filename, data, base_period = "varying", control_group = c("notyettreated")) {
#if (!file.exists(filename)) {
message("Estimating treatment effect for ", yname, " with base period ", base_period, " and saving to ", filename)
est_cs <- att_gt(yname = yname,
tname = "week",
idname = "id",
gname = "firstweek",
data = data,
anticipation = 1,
clustervars = "id",
control_group = control_group,
allow_unbalanced_panel = TRUE,
base_period = base_period)
saveRDS(est_cs, filename)
message("Saved: ", filename)
#} else {
#message("File already exists: ", filename)
#}
}
# Function to apply the TWFE models
apply_twfe_models <- function(data, filename_prefix) {
message("Applying TWFE models and saving to ", paste0(filename_prefix, "_twfe.tex"))
# Apply the TWFE models
m1 <- feols(elec_consumption ~ i(is_hp_installed) | account_id + avg_heating_degree + settlement_week,
data = data, cluster = ~ account_id)
m2 <- feols(gas_consumption ~ i(is_hp_installed) | account_id + avg_heating_degree + settlement_week,
data = data, cluster = ~ account_id)
m3 <- feols(total_consumption ~ i(is_hp_installed) | account_id + avg_heating_degree + settlement_week,
data = data, cluster = ~ account_id)
# Save the models in a LaTeX table
etable(m1, m2, m3,
headers = c("Electricity", "Gas", "Total"),
depvar = FALSE, tex = TRUE,
title = "HP Installation on Yearly Energy Consumption in kWh",
fitstat = ~ N + g + pre_avg + t_obs + r2,
file = paste0(filename_prefix, "_twfe.tex"), replace = TRUE)
CleanPreAverage(paste0(filename_prefix, "_twfe.tex"))
# Generate the initial LaTeX table with TWFE models
etable(m1, m2, m3,
m1, m2, m3,
headers = list(list("TWFE" = 3, "CS" = 3),
list(rep(c("Electricity", "Gas", "Total"), times = 2))),
depvar = FALSE,
tex=TRUE, title = "HP Installation on Yearly Energy Consumption in kWh",
fitstat = ~ N + g + pre_avg + t_obs + r2,
file = paste0(filename_prefix, "_detailed.tex"), replace = TRUE,
label="tab:hp-did-overall-conso-detailed")
CleanPreAverage(paste0(filename_prefix, "_detailed.tex"))
message("TWFE models saved to ", paste0(filename_prefix, "_twfe.tex"), " and ", paste0(filename_prefix, "_detailed.tex"))
}
