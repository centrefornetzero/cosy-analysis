coefs <- rbind(coeftable(tempreg2) %>%
data.frame() %>%
tibble::rownames_to_column("term") %>%
mutate(model = "Control for Floor Area"),
coeftable(tempreg1) %>%
data.frame() %>%
tibble::rownames_to_column("term") %>%
mutate(model = "Without Control for Floor Area")) %>%
separate(term, into = c("is_hp_installed", "remove1", "remove2",
"remove3", "remove44" , "hp_engineer"), sep = ":") %>%
mutate(lower_ci = Estimate - 1.96 * `Std..Error`,
upper_ci = Estimate + 1.96 * `Std..Error`
) %>%
mutate(`/% ATE` = Estimate / m1$coefficients * 100,
lower_ci_ATE = `/% ATE` - 1.96 * (`Std..Error` / m1$coefficients * 100),
upper_ci_ATE = `/% ATE` + 1.96 * (`Std..Error` / m1$coefficients * 100)
) %>%
arrange(model, Estimate) %>%
mutate(hp_engineer = factor(hp_engineer, levels = unique(hp_engineer))) %>%
filter(!remove3 == "floor_area", Estimate < 18)
# Run the regression model
tempreg1 <- feols(consumption_hh ~ i(is_hp_installed, hp_engineer, ref=0) |
account_id + daily_avg_heating_degree  + date,
data = hp_installed %>% filter(treated==1) %>%
inner_join(installers),
cluster = ~account_id)
