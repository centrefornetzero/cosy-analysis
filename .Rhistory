group_by(account_id) %>%
mutate(is_hp_installed = as.numeric(installed_at <= settlement_week),
treated = max(is_hp_installed),
min_settlement_week = min(settlement_week)) %>%
distinct(account_id, settlement_week, .keep_all = TRUE)
